{
    "name": "webconsulting/workos-auth",
    "description": "TYPO3 v14 extension for WorkOS-powered frontend and backend login (AuthKit, SSO, MFA, Admin Portal) and a WorkOS-protected TYPO3 MCP server.",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "keywords": [
        "typo3",
        "typo3-cms-extension",
        "authentication",
        "sso",
        "workos",
        "oidc",
        "mfa",
        "mcp"
    ],
    "authors": [
        {
            "name": "webconsulting",
            "email": "office@webconsulting.at",
            "homepage": "https://webconsulting.at",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/dirnbauer/workos",
    "support": {
        "issues": "https://github.com/dirnbauer/workos/issues",
        "source": "https://github.com/dirnbauer/workos"
    },
    "require": {
        "php": "^8.4",
        "typo3/cms-backend": "^14.3.7",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-extbase": "^14.3.7",
        "typo3/cms-fluid": "^14.3.7",
        "typo3/cms-frontend": "^14.3.7",
        "workos/workos-php": "^9.4"
    },
    "require-dev": {
        "phpat/phpat": "^0.12",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.0",
        "saschaegerer/phpstan-typo3": "^3.0",
        "typo3/cms-workspaces": "^14.3.7",
        "typo3/coding-standards": "^0.9",
        "typo3/testing-framework": "^9.5"
    },
    "conflict": {
        "paragonie/sodium_compat": "<1.24.1 || >=2.0 <2.5.1"
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\WorkosAuth\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\WorkosAuth\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "app-dir": ".Build",
            "extension-key": "workos_auth",
            "version": "2.2.0",
            "web-dir": ".Build/public"
        }
    },
    "scripts": {
        "ci": [
            "@composer validate --strict",
            "@lint",
            "@cs:check",
            "@phpstan",
            "@test:unit",
            "@test:functional"
        ],
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --using-cache=no",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no",
        "lint": "Build/Scripts/runTests.sh -s lint",
        "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
    }
}
