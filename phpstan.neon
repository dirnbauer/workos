parameters:
    # Analyze against the minimum supported runtime (composer.json: php ^8.4)
    # even when CI executes PHPStan on newer PHP versions, so 8.5-only
    # constructs are reported instead of silently accepted.
    phpVersion: 80400
    # Quality policy: the extension must stay green at level 8 or higher.
    # It currently passes at "max"; do not lower below 8.
    level: max
    paths:
        - Classes
        - Configuration
        - Tests
        - ext_localconf.php
    tmpDir: var/cache/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    checkMissingOverrideMethodAttribute: true
    typo3:
        containerXmlPath: null
        requestGetAttributeMapping:
            'backend.user': 'TYPO3\CMS\Core\Authentication\BackendUserAuthentication'
            'frontend.user': 'TYPO3\CMS\Frontend\Authentication\FrontendUserAuthentication'
            normalizedParams: 'TYPO3\CMS\Core\Http\NormalizedParams'
            site: 'TYPO3\CMS\Core\Site\Entity\Site'
    phpat:
        show_rule_names: true
        ignore_doc_comments: true

services:
    -
        class: Webconsulting\WorkosAuth\Tests\Architecture\LayeringTest
        tags:
            - phpat.test
